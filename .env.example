# ==============================================================================
# SENTINEL-X — ENVIRONMENT CONFIGURATION TEMPLATE
# Regulatory Standard: IT Act Section 70A / NCIIPC Supervisory Framework
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production

# Server Binding
HOST=127.0.0.1
PORT=8080

# Logging Level (debug | info | warning | error)
LOG_LEVEL=info

# Air-Gapped Security Compliance (Zero External Cloud Outbound Requests)
AIR_GAPPED_MODE=true

# Tamper-Evident Ledger Storage Mode (memory | disk)
LEDGER_STORAGE=memory
